<?xml version="1.0" encoding="utf-8"?>
<!--
  Fond de l'icône adaptative : le dégradé violet de l'interface du jeu
  (#8b5cf6 → #5b21b6), le même que sur l'icône héritée en PNG.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#8B5CF6"
        android:endColor="#5B21B6" />
</shape>
