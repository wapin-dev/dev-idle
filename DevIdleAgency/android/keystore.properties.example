# Modèle pour android/keystore.properties.
#
# Copier ce fichier en `keystore.properties` (même dossier) et remplir les
# quatre valeurs. Le fichier réel est ignoré par git : il contient les mots de
# passe qui ouvrent la clé de signature.
#
# Voir « Publier sur le Play Store » dans le README pour la commande keytool.

# Chemin du keystore, résolu depuis le dossier android/.
# Le garder HORS du dépôt : le perdre rend toute mise à jour de l'application
# impossible sur le Play Store.
storeFile=../../devidle-release.jks

# Mot de passe du keystore.
storePassword=

# Nom de la clé à l'intérieur du keystore (l'alias donné à keytool).
keyAlias=devidle

# Mot de passe de la clé. Souvent identique à storePassword.
keyPassword=
